<?xml version="1.0" encoding="utf-8"?>
<!-- «Вопрос дня» 4×3: вопрос и до 4 вариантов; нажатие на вариант — в приложение
     с этим ответом (/question/id?a=i). Заполняет WidgetRender.question. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:fontFamily="sans-serif-black" android:text="@string/widget_question_title" android:textAllCaps="true"
            android:textColor="@color/text2" android:textSize="12sp" android:textStyle="italic" />
        <FrameLayout
            android:layout_width="18dp"
            android:layout_height="18dp">
            <ImageView android:id="@+id/flame_outer" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:src="@drawable/flame" />
            <ImageView android:id="@+id/flame_inner" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:src="@drawable/flame_inner" />
            <ImageView android:id="@+id/flame_coal" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:src="@drawable/flame_coal" android:visibility="gone" />
        </FrameLayout>
        <TextView android:id="@+id/days" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="3dp" android:fontFamily="sans-serif-black" android:text="0"
            android:textColor="@color/text" android:textSize="14sp" android:textStyle="italic" />
    </LinearLayout>

    <TextView
        android:id="@+id/qtext"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="4"
        android:textColor="@color/text"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView android:id="@+id/a0" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
        android:background="@drawable/widget_answer" android:ellipsize="end" android:maxLines="2" android:paddingStart="10dp" android:paddingEnd="10dp"
        android:paddingTop="7dp" android:paddingBottom="7dp" android:textColor="@color/text" android:textSize="13sp" />
    <TextView android:id="@+id/a1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
        android:background="@drawable/widget_answer" android:ellipsize="end" android:maxLines="2" android:paddingStart="10dp" android:paddingEnd="10dp"
        android:paddingTop="7dp" android:paddingBottom="7dp" android:textColor="@color/text" android:textSize="13sp" />
    <TextView android:id="@+id/a2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
        android:background="@drawable/widget_answer" android:ellipsize="end" android:maxLines="2" android:paddingStart="10dp" android:paddingEnd="10dp"
        android:paddingTop="7dp" android:paddingBottom="7dp" android:textColor="@color/text" android:textSize="13sp" />
    <TextView android:id="@+id/a3" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
        android:background="@drawable/widget_answer" android:ellipsize="end" android:maxLines="2" android:paddingStart="10dp" android:paddingEnd="10dp"
        android:paddingTop="7dp" android:paddingBottom="7dp" android:textColor="@color/text" android:textSize="13sp" />

    <TextView
        android:id="@+id/qnote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:textColor="@color/text2"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
